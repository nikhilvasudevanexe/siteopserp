# Supabase project credentials (anon key is safe to ship to the browser —
# RLS is what protects the data, not the secrecy of this key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Storage bucket used for attachments (photos, files, signatures).
VITE_SUPABASE_STORAGE_BUCKET=attachments
